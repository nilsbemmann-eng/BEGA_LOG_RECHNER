# Kopieren nach .env und Werte anpassen. .env wird nicht committet (.gitignore).
# Keine echten Zugangsdaten in dieses Beispiel eintragen (Abschnitt 13).

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://bega:bega@localhost:5432/bega_frachtpreis

JWT_SECRET_KEY=change-me-to-a-random-secret

DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=./local_storage/documents

# Postfach (IMAP) - siehe docs/OFFENE_ENTSCHEIDUNGEN.md Punkt 1
MAILBOX_HOST=
MAILBOX_USER=
MAILBOX_PASSWORD=
MAILBOX_FOLDER=INBOX
MAILBOX_USE_SSL=true

GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=bega-frachtpreisrechner/1.0 (contact: ops@example.invalid)

ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
DEFAULT_ROUTING_PROFILE=truck

OCR_PROVIDER=pdf_text
OCR_MIN_AUTO_CONFIDENCE=0.95
OCR_MIN_FLAGGED_CONFIDENCE=0.80

# Nur noetig, wenn OCR_PROVIDER=llm_vision (Scans/Fotos, siehe
# app/providers/ocr/llm_vision_provider.py und docs/OFFENE_ENTSCHEIDUNGEN.md Punkt 3)
ANTHROPIC_API_KEY=
OCR_VISION_MODEL=claude-sonnet-5
OCR_VISION_MAX_PAGES=5

KM_TOLERANCE_STANDARD_PERCENT=8.0
KM_TOLERANCE_INNER_CITY_PERCENT=12.0
PRICE_DEVIATION_TOLERANCE_PERCENT=5.0

EXPORT_STORAGE_PATH=./local_storage/exports

# Kommagetrennte Liste erlaubter Frontend-Origins (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:3000
